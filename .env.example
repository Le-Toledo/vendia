# Environment Variables Example for VendeAI SaaS

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database local (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://vendeai_user:vendeai_pass_2026@localhost:5432/vendeai_db?schema=public"
DB_USER=vendeai_user
DB_PASSWORD=vendeai_pass_2026
DB_NAME=vendeai_db
DB_PORT=5432

# Staging no Supabase Free: substitua DATABASE_URL pela string do
# Supavisor Session pooler (porta 5432) exibida em Project > Connect.
# Não são necessárias chaves anon/service-role: o Supabase é usado apenas como PostgreSQL.

# Authentication / Security
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-of-at-least-32-characters"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Provider Configuration
# Supported options: mock (development only), openai, gemini, groq
AI_PROVIDER=mock
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Google authentication (disabled until a real OAuth client is configured)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=""

# Comma-separated browser origins. Native mobile clients normally send no Origin.
CORS_ORIGINS="http://localhost:8080,http://localhost:3000"

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Public privacy/support details; configure verified email delivery in production.
PRIVACY_CONTROLLER_NAME="VendeAI"
SUPPORT_EMAIL="vendeai.suport@gmail.com"
RESEND_API_KEY=""
MAIL_FROM=""

# Apple server credentials: never put private keys in the Flutter app.
APPLE_AUTH_ENABLED=false
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
APPLE_TOKEN_ENCRYPTION_KEY=""

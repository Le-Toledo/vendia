# Environment Variables Example for VendeAI SaaS

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (Supabase / PostgreSQL)
DATABASE_URL="postgresql://vendeai_user:vendeai_pass_2026@localhost:5432/vendeai_db?schema=public"
DB_USER=vendeai_user
DB_PASSWORD=vendeai_pass_2026
DB_NAME=vendeai_db
DB_PORT=5432

# Supabase Auth & Service Role Config (Optional when using Supabase cloud)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Authentication / Security
JWT_SECRET="vendeai_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="vendeai_super_secret_refresh_jwt_key_2026_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Provider Configuration
# Supported options: 'mock', 'openai', 'gemini', 'claude'
AI_PROVIDER=mock
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
